# Postgres do Neon. Crie o projeto em https://neon.tech e cole a connection string aqui.
DATABASE_URL=

# Handle público da InfinityPay que recebe os pagamentos (sem @ ou $).
INFINITEPAY_HANDLE=arrudonimous

# URL pública da aplicação, usada pra montar redirect_url e webhook_url da InfinityPay.
# Em desenvolvimento local pode deixar em branco (usa o origin da requisição).
NEXT_PUBLIC_APP_URL=

# Chave usada pra assinar o cookie de sessão de login. Gere um valor aleatório com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Token de leitura do Hugging Face (grátis), usado pelo "Parece com IA?" no editor
# pra traduzir o texto e rodar o detector. Gere em huggingface.co/settings/tokens.
HUGGINGFACE_API_TOKEN=
